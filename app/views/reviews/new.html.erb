<h1>New Review for <%= @restaurant.name %></h1>

<%= simple_form_for [@restaurant, @review] do |f| %>
  <%= f.input :rating, as: :integer, input_html: { min: 0, max: 5 } %>
  <%= f.input :content %>
  <%= f.button :submit, 'Add Review', class: 'btn btn-primary' %>
<% end %>

<%= link_to 'Back to restaurant', restaurant_path(@restaurant), class: 'btn btn-secondary mt-2' %>

